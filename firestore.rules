rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && userDoc().data.role in ['teacher', 'admin'];
    }

    function ownsCourseData(data) {
      return isSignedIn()
        && (
          data.ownerUid == request.auth.uid
          || (
            (!data.keys().hasAny(['ownerUid']) || data.ownerUid == null)
            && data.ownerEmail == userDoc().data.email
          )
        );
    }

    function canManageExistingCourse() {
      return isAdmin() || ownsCourseData(resource.data);
    }

    function canManageCourse(courseId) {
      return isAdmin()
        || ownsCourseData(getAfter(/databases/$(database)/documents/courses/$(courseId)).data);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));

      match /skills/{skillId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher());
        allow write: if isSignedIn() && request.auth.uid == uid;
      }

      match /progress/{progressId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher());
        allow write: if isSignedIn() && request.auth.uid == uid;
      }

      match /tutorSessions/{sessionId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;

        match /messages/{messageId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true || isTeacher();
      allow create: if isTeacher() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher()
        && canManageExistingCourse()
        && (
          isAdmin()
          || (
            resource.data.keys().hasAny(['ownerUid'])
            && request.resource.data.ownerUid == resource.data.ownerUid
          )
          || (
            (!resource.data.keys().hasAny(['ownerUid']) || resource.data.ownerUid == null)
            && request.resource.data.ownerUid == request.auth.uid
          )
        );
      allow delete: if isTeacher() && canManageExistingCourse();

      match /modules/{moduleId} {
        allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.published == true || isTeacher();
        allow write: if isTeacher() && canManageCourse(courseId);
      }

      match /assets/{assetId} {
        allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.published == true || isTeacher();
        allow write: if isTeacher() && canManageCourse(courseId);
      }

      match /finalTests/{moduleId} {
        allow read: if isTeacher();
        allow write: if isTeacher() && canManageCourse(courseId);

        match /permissions/{uid} {
          allow read: if isTeacher() || (isSignedIn() && request.auth.uid == uid);
          allow write: if isTeacher() && canManageCourse(courseId);
        }

        match /sessions/{sessionId} {
          allow read: if isTeacher() || (isSignedIn() && resource.data.uid == request.auth.uid);
          allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
          allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
        }
      }

      match /finalTestOptions/{moduleId} {
        allow read: if isSignedIn();
        allow write: if isTeacher() && canManageCourse(courseId);
      }

      match /moduleAiOptions/{moduleId} {
        allow read: if isSignedIn();
        allow write: if isTeacher() && canManageCourse(courseId);
      }

      match /tutorReviewQueue/{flagId} {
        allow read: if isTeacher();
        allow update: if isTeacher();
        allow create, delete: if false;
      }

      match /tutorActivity/{activityId} {
        allow read: if isTeacher();
        allow update: if isTeacher();
        allow create, delete: if false;
      }

      match /studentTutorSummaries/{studentUid} {
        allow read: if isTeacher();
        allow write: if false;
      }
    }

    match /liveSessions/{courseId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() && canManageCourse(courseId);
    }
  }
}
