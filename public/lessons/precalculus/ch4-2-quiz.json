      "correctIndex": 2,
      "hints": [
        "$ \\pi $ is half a revolution from $ (1,0) $.",
        "It lies on the negative x-axis."
      ],
      "feedbackIfWrong": "$ t = \\pi $ corresponds to $ (-1, 0) $."
    },
