  "title": "Properties of Logarithms",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "prompt": "The change-of-base formula states that $\\log_a x =$",
      "options": [
        "A. $\\frac{\\log_b a}{\\log_b x}$",
        "B. $\\frac{\\log_b x}{\\log_b a}$",
        "C. $\\log_b x - \\log_b a$",
        "D. $\\log_b \\frac{x}{a}$"
      ],
      "correctIndex": 1,
      "hints": [
        "The original base $a$ goes in the denominator.",
        "It is a ratio of two logs with the same new base $b$."
      ],
      "feedbackIfWrong": "The correct formula is $\\log_a x = \\frac{\\log_b x}{\\log_b a}$."
    },
    {
      "id": "q2",
      "type": "fill-blank",
      "prompt": "$\\log_a (uv) = \\log_a u + \\log_a v$ is called the ___ property of logarithms.",
      "blanks": [
        {
          "accept": [
            "product"
          ]
        }
      ],
      "hints": [
        "It involves multiplication inside the log.",
        "The result is a sum of two logs."
      ],
      "feedbackIfWrong": "This is the product property."
    },
    {
      "id": "q3",
      "type": "short-answer",
      "prompt": "Evaluate $\\log_2 32$.",
      "answers": [
        "5",
        "five"
      ],
      "hints": [
        "Ask: 2 to what power equals 32?",
        "$2^5 = 32$."
      ],
      "feedbackIfWrong": "$\\log_2 32 = 5$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "prompt": "Which expression correctly expands $\\ln(5x^2)$?",
      "options": [
        "A. $\\ln 5 + 2\\ln x$",
        "B. $\\ln 5 \\cdot 2\\ln x$",
        "C. $2\\ln 5x$",
        "D. $\\ln 5 - 2\\ln x$"
      ],
      "correctIndex": 0,
      "hints": [
        "Use product rule: $\\ln(5x^2) = \\ln 5 + \\ln x^2$.",
        "Then power rule: $\\ln x^2 = 2\\ln x$."
      ],
      "feedbackIfWrong": "The expansion is $\\ln 5 + 2\\ln x$."
    },
    {
      "id": "q5",
      "type": "fill-blank",
      "prompt": "To condense $2\\log x + 3\\log y$, first rewrite $2\\log x$ as $\\log$ of $x$ to the ___ power.",
      "blanks": [
        {
          "accept": [
            "2",
            "two"
          ]
        }
      ],
      "hints": [
        "The coefficient becomes the exponent.",
        "This is the power rule."
      ],
      "feedbackIfWrong": "It becomes $\\log x^2$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "prompt": "Condense $\\log_5 a + \\log_5 b - \\log_5 c$ into a single logarithm.",
      "options": [
        "A. $\\log_5(abc)$",
        "B. $\\log_5\\frac{ab}{c}$",
        "C. $\\log_5\\frac{a+b}{c}$",
        "D. $\\log_5(a + b - c)$"
      ],
      "correctIndex": 1,
      "hints": [
        "Sum of logs becomes product: $\\log_5 a + \\log_5 b = \\log_5(ab)$.",
        "Then subtract $\\log_5 c$ becomes division."
      ],
      "feedbackIfWrong": "The condensed form is $\\log_5\\frac{ab}{c}$."
    },
    {
      "id": "q7",
      "type": "short-answer",
      "prompt": "Solve $\\log x = 3$ (common log). $x =$ ___",
      "answers": [
        "1000"
      ],
      "hints": [
        "$\\log_{10} x = 3$ means $x = 10^3$.",
        "$10^3 = 1000$."
      ],
      "feedbackIfWrong": "$x = 1000$."
    },
    {
