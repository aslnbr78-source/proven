    {
      "id": "q11",
      "type": "multiple-choice",
      "prompt": "Expand $\\log\\frac{x^3}{y}$ completely.",
      "options": [
        "A. $3\\log x - \\log y$",
        "B. $\\log x^3 + \\log y$",
        "C. $\\log x^3 - \\log y$",
        "D. $3\\log x + \\log y$"
      ],
      "correctIndex": 0,
      "hints": [
        "Quotient rule: $\\log(x^3/y) = \\log x^3 - \\log y$.",
        "Then power: $\\log x^3 = 3\\log x$."
      ],
      "feedbackIfWrong": "The expansion is $3\\log x - \\log y$."
    },
    {
      "id": "q12",
      "type": "short-answer",
      "prompt": "What is the exact value of $\\ln e^7$?",
      "answers": [
        "7"
      ],
      "hints": [
        "Use inverse property: $\\ln e^x = x$.",
        "The natural log and $e$ cancel."
      ],
      "feedbackIfWrong": "$\\ln e^7 = 7$."
    },
    {
      "id": "q13",
      "type": "multiple-choice",
      "prompt": "Which of the following is equivalent to $2\\ln a + \\frac{1}{2}\\ln b$?",
      "options": [
        "A. $\\ln(2a\\sqrt{b})$",
        "B. $\\ln(a^2\\sqrt{b})$",
        "C. $\\ln\\frac{a^2}{\\sqrt{b}}$",
        "D. $\\ln(a^2 + \\sqrt{b})$"
      ],
      "correctIndex": 1,
      "hints": [
        "Power rule first: $\\ln a^2 + \\ln b^{1/2}$.",
        "Then product rule: $\\ln(a^2 \\sqrt{b})$."
      ],
      "feedbackIfWrong": "The condensed form is $\\ln(a^2\\sqrt{b})$."
    },
    {
      "id": "q14",
      "type": "multiple-choice",
      "prompt": "The expression $\\log(x^2 - 4)$ can be expanded as:",
      "options": [
        "A. $2\\log x - \\log 4$",
        "B. $\\log(x-2) + \\log(x+2)$",
        "C. $\\log(x^2) - \\log 4$",
        "D. It cannot be expanded into a sum/difference of logs"
      ],
      "correctIndex": 1,
      "hints": [
        "Factor $x^2-4 = (x-2)(x+2)$.",
        "Then product rule applies."
      ],
      "feedbackIfWrong": "Factor first: $\\log(x^2-4) = \\log[(x-2)(x+2)] = \\log(x-2) + \\log(x+2)$."
    },
