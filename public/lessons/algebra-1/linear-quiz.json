{
  "type": "quiz",
  "id": "linear-quiz",
  "title": "Linear Equations Quiz",
  "timeLimit": 300,
  "questions": [
    {
      "id": "q1",
      "prompt": "What is the slope of $y = 3x - 1$?",
      "options": ["$3$", "$-1$", "$1$", "$-3$"],
      "correctIndex": 0,
      "hints": [
        "Use the form $y = mx + b$.",
        "The slope $m$ is the number multiplying $x$."
      ],
      "feedbackIfWrong": "In $y = mx + b$, the slope is the coefficient of $x$. Here $m = 3$."
    },
    {
      "id": "q2",
      "prompt": "What is the y-intercept of $y = 3x - 1$?",
      "options": ["$3$", "$-1$", "$1$", "$0$"],
      "correctIndex": 1,
      "hints": [
        "The y-intercept is the constant term when $x = 0$.",
        "In $y = mx + b$, the y-intercept is $b$."
      ],
      "feedbackIfWrong": "When $x = 0$, $y = b$. For this line, $b = -1$."
    },
    {
      "id": "q3",
      "prompt": "Solve for $x$: $2x + 6 = 0$",
      "options": ["$x = 3$", "$x = -3$", "$x = 6$", "$x = -6$"],
      "correctIndex": 1,
      "hints": [
        "Subtract $6$ from both sides first.",
        "Then divide both sides by $2$."
      ],
      "feedbackIfWrong": "$2x = -6$, so $x = -3$."
    }
  ]
}
