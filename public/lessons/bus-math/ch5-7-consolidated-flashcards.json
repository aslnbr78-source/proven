{
  "cards": [
    {
      "front": "What is a [[kw:variable]]?",
      "back": [
        "[[imp:A letter that stands for an unknown number.]]",
        "Example: A, B, X. If no number in front, it's 1."
      ]
    },
    {
      "back": [
        "[[imp:A fixed number, never changes.]]",
        "Example: 5, –3, 100."
      ],
      "front": "What is a [[kw:constant]]?"
    },
    {
      "back": [
        "[[imp:Expression]] – no equals sign (4A – 3).",
        "[[imp:Equation]] – has equals sign (A + 3 = 10)."
      ],
      "front": "Expression vs. equation?"
    },
    {
      "front": "What is the [[kw:Equality Rule]]?",
      "back": [
        "[[imp:Add, subtract, multiply or divide both sides by the same non‑zero number.]]",
        "Keeps the equation balanced."
      ]
    },
    {
      "front": "Solve $X + 6 = 20$.",
      "back": [
        "Subtract 6 from both sides: $X = 14$."
      ]
    },
    {
      "front": "Solve $A - 9 = 15$.",
      "back": [
        "Add 9 to both sides: $A = 24$."
      ]
    },
    {
      "front": "Solve $5A = 25$.",
      "back": [
        "Divide both sides by 5: $A = 5$."
      ]
    },
    {
      "back": [
        "Multiply both sides by 4: $A = 12$."
      ],
      "front": "Solve $A/4 = 3$."
    },
    {
      "front": "Order to solve $3A + 2 = 14$?",
      "back": [
        "1. Subtract 2 → $3A = 12$.",
        "2. Divide by 3 → $A = 4$."
      ]
    },
    {
      "front": "List the [[kw:five rules]] for solving equations.",
      "back": [
        "1. +constant → subtract",
        "2. –constant → add",
        "3. ×coeff → divide",
        "4. ÷number → multiply",
        "5. multi‑step → undo +/– first, then ×/÷."
      ]
    },
    {
      "back": [
        "$N + 8 = 58$ → $N = 50$."
      ],
      "front": "Translate \"a number increased by 8 equals 58\"."
    },
    {
      "back": [
        "[[imp:\"5 less than N\" is N – 5, NOT 5 – N.]]"
      ],
      "front": "What does \"less than\" mean in equations?"
    },
    {
      "back": [
        "[[imp:Multiply by 2.]] Twice a number → $2N$."
      ],
      "front": "What does \"twice\" mean?"
    },
    {
      "back": [
        "[[imp:Understand → Translate → Solve → Conclude.]]"
      ],
      "front": "Blueprint for word problems?"
    },
    {
      "front": "Total cost formula?",
      "back": [
        "[[imp:Total = Price × Quantity.]]"
      ]
    },
    {
      "back": [
        "Total bill = flat fee + (hourly rate × hours)."
      ],
      "front": "Plumber flat fee + hourly rate equation?"
    },
    {
      "front": "Age problem: present age A, future 5 years?",
      "back": [
        "Future = $A + 5$. Past = $A - 5$."
      ]
    },
    {
      "back": [
        "[[imp:$D = R \\times T$ (Distance = Rate × Time).]]"
      ],
      "front": "Distance formula?"
    },
    {
      "front": "How do you check a solved equation?",
      "back": [
        "Substitute the answer back into the original equation; both sides must be equal."
      ]
    },
    {
      "front": "What does [[kw:percent]] mean?",
      "back": [
        "[[imp:Per hundred.]] 15% = 15/100 = 0.15."
      ]
    },
    {
      "back": [
        "Move decimal point two places right, add % sign.",
        "$0.85 = 85\\%$."
      ],
      "front": "Decimal → percent (D2P)?"
    },
    {
      "back": [
        "Drop % sign, move decimal two places left.",
        "$75\\% = 0.75$."
      ],
      "front": "Percent → decimal (P2D)?"
    },
    {
      "front": "Fraction → percent?",
      "back": [
        "Divide numerator by denominator, then move decimal two right and add %.",
        "$\\frac{3}{4} = 0.75 = 75\\%$."
      ]
    },
    {
      "front": "Percent → fraction?",
      "back": [
        "Put percent over 100, reduce.",
        "$40\\% = \\frac{40}{100} = \\frac{2}{5}$."
      ]
    },
    {
      "back": [
        "Less than 1%, e.g., $\\frac{1}{2}\\%$. Convert the fraction to decimal first, then move decimal two left."
      ],
      "front": "What is a [[kw:fractional percent]]?"
    },
    {
      "back": [
        "32.73% – look at third decimal (7), so round up."
      ],
      "front": "Round $32.727\\%$ to nearest hundredth %."
    },
    {
      "back": [
        "[[imp:$P = R \\times B$ (Portion = Rate × Base).]]"
      ],
      "front": "Portion formula?"
    },
    {
      "front": "What is the [[kw:base]]?",
      "back": [
        "[[imp:The whole or original amount.]] It corresponds to 100%."
      ]
    },
    {
      "front": "What is the [[kw:rate]]?",
      "back": [
        "[[imp:The percent written as a decimal.]] It tells what part of the base we have."
      ]
    },
    {
      "front": "What is the [[kw:portion]]?",
      "back": [
        "[[imp:The part or amount that the percent represents.]]"
      ]
    },
    {
      "back": [
        "$P = 0.30 \\times 200 = 60$."
      ],
      "front": "Find the portion: 30% of 200?"
    },
    {
      "front": "Find the rate: 15 out of 60?",
      "back": [
        "$R = 15 \\div 60 = 0.25 = 25\\%$."
      ]
    },
    {
      "back": [
        "$B = 75 \\div 0.25 = 300$."
      ],
      "front": "Find the base: 25% of what is 75?"
    },
    {
      "front": "Percent increase formula?",
      "back": [
        "Percent Change = (Change ÷ Original) × 100.",
        "Original is always the base."
      ]
    },
    {
      "front": "Price rose from $40 to $50. Percent increase?",
      "back": [
        "Change $10, $10/40 = 0.25 = 25%."
      ]
    },
    {
      "back": [
        "[[imp:Reduction off manufacturer's list price for retailers.]] Not for early payment."
      ],
      "front": "What is a [[kw:trade discount]]?"
    },
    {
      "front": "Trade discount amount formula?",
      "back": [
        "[[imp:Discount = List Price × Trade Discount Rate.]]"
      ]
    },
    {
      "back": [
        "Net Price = List Price – Discount.",
        "Or Net = List × (1 – Trade Discount Rate)."
      ],
      "front": "Net price after trade discount?"
    },
    {
      "front": "Find list price from net price and discount rate?",
      "back": [
        "List = Net ÷ (1 – Trade Discount Rate)."
      ]
    },
    {
      "front": "What is a [[kw:chain discount]]?",
      "back": [
        "A series of trade discounts (e.g., 20/10/5) applied one after another. Never add percents!"
      ]
    },
    {
      "back": [
        "Multiply complements of each discount: (1–R1) × (1–R2) × …"
      ],
      "front": "How to find net price equivalent rate?"
    },
    {
      "back": [
        "1 – Net Price Equivalent Rate."
      ],
      "front": "Single equivalent discount rate?"
    },
    {
      "back": [
        "[[imp:Buyer pays freight, owns goods at seller's dock.]] Freight added to invoice."
      ],
      "front": "What does [[kw:FOB shipping point]] mean?"
    },
    {
      "front": "What does [[kw:FOB destination]] mean?",
      "back": [
        "[[imp:Seller pays freight, owns until buyer receives.]] Buyer does not pay freight."
      ]
    },
    {
      "back": [
        "[[imp:Reduction from net price for paying early.]] Optional."
      ],
      "front": "What is a [[kw:cash discount]]?"
    },
    {
      "front": "What do \"2/10, n/30\" mean?",
      "back": [
        "2% discount if paid within 10 days, otherwise full net due in 30 days."
      ]
    },
    {
      "back": [
        "Discount and net due dates start from invoice date."
      ],
      "front": "Ordinary dating?"
    },
    {
      "front": "EOM dating?",
      "back": [
        "Discount period begins after the end of the invoice month."
      ]
    },
    {
      "back": [
        "Discount period begins when goods are received."
      ],
      "front": "ROG dating?"
    },
    {
      "back": [
        "[[imp:No! Cash discount is only on net merchandise price.]]"
      ],
      "front": "Does cash discount apply to freight?"
    },
    {
      "front": "Check amount formula with freight?",
      "back": [
        "Check = (Net Price × (1 – Cash Discount Rate)) + Freight."
      ]
    },
    {
      "back": [
        "[[imp:Credit = Payment ÷ (1 – Cash Discount Rate).]]"
      ],
      "front": "Partial payment credit formula?"
    },
    {
      "front": "Outstanding balance after partial payment?",
      "back": [
        "Previous Balance – Credit Received."
      ]
    },
    {
      "front": "Why is the original amount always the base in percent change?",
      "back": [
        "Because the change is compared to the starting value."
      ]
    },
    {
      "front": "What happens if the numeric and verbal amounts on a check differ?",
      "back": [
        "[[imp:The bank pays the verbal (word) amount.]]"
      ]
    }
  ],
