        "explanation": [
          "[[kw:Variable]] = letter for unknown (A, B, X). If no number in front, coefficient is 1.",
          "[[kw:Constant]] = fixed number (5, -3).",
          "[[kw:Expression]] = combination without = sign (4A – 3).",
          "[[kw:Equation]] = two expressions set equal (A + 3 = 10)."
        ],
        "formulaCard": {
          "title": "Variable & Constant Rules",
          "notes": [
            "Place variables left, constants right.",
            "Solve to find the unknown."
          ],
          "formula": "No number in front → 1\nNo sign in front → +"
        }
