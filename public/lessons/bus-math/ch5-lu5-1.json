      "id": "inverse-operations",
      "discoveryHook": {
        "scenario": "If 4 gift cards cost $200, then 4G = 200. To find one card's price, divide both sides by 4. That's the inverse of multiplication."
      },
      "concept": {
        "formulaCard": {
          "title": "Inverse Operations",
          "notes": [
            "Always undo addition/subtraction before multiplication/division."
          ],
          "formula": "$$+ \\leftrightarrow -$$ $$ \\times \\leftrightarrow \\div$$"
        },
        "visuals": [
          {
            "type": "table",
            "rows": [
              {
                "0": "5A = 25",
                "1": "None",
                "2": "÷5 → A = 5",
                "3": "5"
              },
              {
                "0": "A/4 = 3",
                "1": "None",
                "2": "×4 → A = 12",
                "3": "12"
              },
              {
                "0": "3A + 2 = 14",
                "1": "–2 → 3A = 12",
                "2": "÷3 → A = 4",
                "3": "4"
              },
              {
                "0": "2A – 6 = 10",
                "1": "+6 → 2A = 16",
                "2": "÷2 → A = 8",
                "3": "8"
              }
            ],
            "caption": "Reverse the order of operations to isolate the variable.",
            "headers": [
              "Equation",
              "Step 1 (Undo +/–)",
              "Step 2 (Undo ×/÷)",
              "Solution"
            ],
            "title": "Inverse Operations at a Glance",
            "variant": "colorful"
          }
        ],
        "explanation": [
          "To isolate a variable multiplied by a number, **divide** both sides by that number.",
          "To isolate a variable divided by a number, **multiply** both sides by that number.",
          "For two-step equations: undo addition/subtraction first, then multiplication/division."
        ]
      }
