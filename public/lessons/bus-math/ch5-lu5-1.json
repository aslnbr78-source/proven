      "examples": [
        {
          "role": "guided",
          "steps": [
            "Divide both sides by 6: A = 9.",
            "Check: 6 × 9 = 54."
          ],
          "title": "A – Simple multiplication",
          "prompt": "Solve 6A = 54."
        },
        {
          "prompt": "For 4A + 8 = 28, why subtract before dividing?",
          "steps": [
            "Divide first: A + 2 = 7, then subtract 2 → A = 5.",
            "But 4(5)+8=28? 20+8=28 works. Actually both ways can work, but standard rule is safer."
          ],
          "title": "B – Why reverse order?",
          "peerPrompt": "Try dividing first; what happens?",
          "minLength": 2,
          "role": "peer-explain"
        },
        {
          "steps": [
            "Subtract 9: 7C = 42.",
            "Divide by 7: C = 6.",
            "Check: 7(6)+9=51."
          ],
          "prompt": "Solve 7C + 9 = 51.",
          "role": "independent",
          "title": "C – Two-step solve"
        }
