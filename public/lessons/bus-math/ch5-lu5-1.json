      "concept": {
        "explanation": [
          "[[imp:Rule 1]]: Unknown + constant → subtract constant from both sides.",
          "[[imp:Rule 2]]: Unknown – constant → add constant to both sides.",
          "[[imp:Rule 3]]: Coefficient × unknown → divide both sides by coefficient.",
          "[[imp:Rule 4]]: Unknown ÷ number → multiply both sides by that number.",
          "[[imp:Rule 5]]: Multiple operations → undo addition/subtraction first, then multiplication/division."
        ],
        "formulaCard": {
