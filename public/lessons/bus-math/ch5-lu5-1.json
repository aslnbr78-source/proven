      "title": "2. The Equality Rule: Balance the Scale",
      "discoveryHook": {
        "scenario": "Think of an equation as a balanced seesaw. Whatever you do to one side, you must do to the other to keep it level."
      },
      "teacherCues": [
        "Draw a seesaw; label pans with expressions.",
        "Ask: 'What must you do to keep it level?'"
      ],
      "id": "equality-rule",
      "confusionCorner": {
        "body": "[[imp:Perform the operation on the entire side, not just one term.]]",
        "title": "Watch out!"
      },
      "concept": {
        "formulaCard": {
          "formula": "$$\\text{If } A = B \\text{, then } A + C = B + C$$",
          "title": "Equality Rule",
          "notes": [
            "Applies to –, ×, ÷ too.",
            "Never divide by 0."
          ]
        },
        "explanation": [
          "[[kw:Equality Rule]]: You may add, subtract, multiply, or divide both sides by the same number (≠0) without changing equality.",
          "Goal: isolate the variable on one side.",
          "Always check by substituting the answer back into the original equation."
        ],
        "visuals": [
          {
            "title": "Four Balancing Acts",
            "variant": "colorful",
            "caption": "Same operation, both sides – the key to solving.",
            "headers": [
              "Operation on Both Sides",
              "Example",
              "Effect"
            ],
            "type": "table",
            "rows": [
              {
                "0": "Add same number",
                "1": "A – 5 = 3  → +5 → A = 8",
                "2": "Undoes subtraction"
              },
              {
                "0": "Subtract same number",
                "1": "A + 8 = 58 → –8 → A = 50",
                "2": "Undoes addition"
              },
              {
                "0": "Multiply same number",
                "1": "A/4 = 3 → ×4 → A = 12",
                "2": "Undoes division"
              },
              {
                "0": "Divide same number",
                "1": "3A = 12 → ÷3 → A = 4",
                "2": "Undoes multiplication"
              }
            ]
          }
        ]
      },
      "examples": [
        {
          "title": "A – Subtract to isolate",
          "steps": [
            "Subtract 8 both sides: A + 8 – 8 = 58 – 8.",
            "A = 50.",
            "Check: 50 + 8 = 58."
          ],
          "prompt": "Solve A + 8 = 58.",
          "role": "guided"
        },
        {
          "peerPrompt": "What happens to the seesaw?",
          "steps": [
            "If you subtract from only one side, the balance breaks.",
            "The equation must remain true."
          ],
          "minLength": 2,
          "title": "B – Why both sides?",
          "prompt": "Explain why you must subtract 8 from both sides, not just one.",
          "role": "peer-explain"
        },
        {
          "prompt": "Solve N – 5 = 9.",
          "title": "C – Solve & check",
          "steps": [
            "Add 5 both sides: N = 14.",
            "Check: 14 – 5 = 9."
          ],
          "role": "independent"
        }
      ],
      "challengeCorner": {
        "prompt": "Solve and check: Y + 12.5 = 30.1.",
        "optional": true,
        "hints": [
          "Subtract 12.5.",
          "30.1 – 12.5 = ?"
        ],
        "type": "short-answer",
        "answers": [
          "17.6"
        ]
      }
