{
  "title": "Solving Equations for the Unknown",
  "cards": [
    {
      "front": "What is a [[kw:variable]]?",
      "back": [
        "[[imp:A letter that represents an unknown number.]]",
        "Examples: A, B, X, Y.",
        "If no number in front, coefficient = 1 (so B = 1B)."
      ]
    },
    {
      "front": "What is a [[kw:constant]]?",
      "back": [
        "A number with a fixed value (it never changes).",
        "Examples: 5, –3, 100.",
        "Opposite of a variable."
      ]
    },
    {
      "front": "Differentiate: [[kw:expression]] vs. [[kw:equation]].",
      "back": [
        "[[imp:Expression]]: no equals sign (e.g., 4A – 3).",
        "[[imp:Equation]]: has an equals sign (e.g., A + 3 = 10).",
        "An equation states that two expressions are equal."
      ]
    },
    {
      "front": "State the [[kw:Equality Rule]].",
      "back": [
        "[[imp:You can add, subtract, multiply, or divide both sides of an equation by the same non-zero number, and the equality remains true.]]",
        "Do the same operation on both sides to keep the balance."
      ]
    },
    {
      "back": [
        "[[imp:Subtract 8 from both sides.]]",
        "$A + 8 - 8 = 58 - 8$ → $A = 50$.",
        "Check: 50 + 8 = 58."
      ],
      "front": "How do you solve $A + 8 = 58$?"
    },
    {
      "back": [
        "[[imp:Add 9 to both sides.]]",
        "$B - 9 + 9 = 20 + 9$ → $B = 29$.",
        "Check: 29 - 9 = 20."
      ],
      "front": "How do you solve $B - 9 = 20$?"
    },
    {
      "back": [
        "[[imp:Divide both sides by 5.]]",
        "$5A \\div 5 = 25 \\div 5$ → $A = 5$.",
        "Check: 5 × 5 = 25."
      ],
      "front": "How do you solve $5A = 25$?"
    },
    {
      "front": "How do you solve $A/4 = 3$?",
      "back": [
        "[[imp:Multiply both sides by 4.]]",
        "$A/4 \\times 4 = 3 \\times 4$ → $A = 12$.",
        "Check: 12/4 = 3."
      ]
    },
    {
      "back": [
        "[[imp:1. Undo addition/subtraction: subtract 2 → 3A = 12.]]",
        "[[imp:2. Undo multiplication/division: divide by 3 → A = 4.]]",
        "Always reverse the order of operations."
      ],
      "front": "What is the correct order for solving $3A + 2 = 14$?"
    },
    {
      "back": [
        "1. Unknown + constant → subtract constant.",
        "2. Unknown – constant → add constant.",
        "3. Coefficient × unknown → divide by coefficient.",
        "4. Unknown ÷ number → multiply by that number.",
        "5. Multiple operations → undo +/– first, then ×/÷."
      ],
      "front": "List the [[kw:five rules]] for solving equations."
    },
    {
      "back": [
        "Let N = the number.",
        "Equation: $N + 8 = 58$.",
        "Solution: N = 50."
      ],
      "front": "Translate: \"A number increased by 8 equals 58\"."
    },
    {
      "front": "Translate: \"Three times a number minus 4 equals 11\". Solve for the number.",
      "back": [
        "Equation: $3N - 4 = 11$.",
        "Add 4: $3N = 15$.",
        "Divide by 3: $N = 5$."
      ]
    }
  ],
