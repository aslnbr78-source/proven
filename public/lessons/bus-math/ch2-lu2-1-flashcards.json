{
  "id": "ch2-lu2-1-flashcards",
  "title": "Types of Fractions & Conversion Procedures",
  "cards": [
    {
      "front": "Define a [[kw:proper fraction]].",
      "back": [
        "[[imp:Numerator < Denominator; value less than 1.]]",
        "Example: $\\frac{3}{4}$, $\\frac{2}{7}$."
      ]
    },
    {
      "front": "Define an [[kw:improper fraction]].",
      "back": [
        "[[imp:Numerator ≥ Denominator; value ≥ 1.]]",
        "Example: $\\frac{9}{5}$, $\\frac{15}{15}$."
      ]
    },
    {
      "back": [
        "[[imp:Sum of a whole number and a proper fraction.]]",
        "Example: $3\\frac{1}{2}$, $5\\frac{7}{8}$."
      ],
      "front": "What is a [[kw:mixed number]]?"
    },
    {
      "back": [
        "[[imp:Divide numerator by denominator.]]",
        "Quotient = whole part.",
        "Remainder = numerator of fraction; denominator stays same.",
        "Example: $\\frac{17}{5} = 3\\frac{2}{5}$."
      ],
      "front": "How do you convert an improper fraction to a mixed number?"
    },
    {
      "back": [
        "[[imp:(Denominator × Whole) + Numerator over original denominator.]]",
        "Example: $5\\frac{7}{8} = \\frac{(8 \\times 5) + 7}{8} = \\frac{47}{8}$."
      ],
      "front": "How do you convert a mixed number to an improper fraction?"
    },
    {
      "front": "What does it mean to reduce a fraction to [[kw:lowest terms]]?",
      "back": [
        "[[imp:Divide numerator and denominator by their greatest common divisor (GCD).]]",
        "No number except 1 divides both.",
        "Example: $\\frac{24}{36} = \\frac{2}{3}$ (GCD 12)."
      ]
    },
    {
      "back": [
        "List factors of both numbers; pick the largest common one.",
        "Or divide by common primes until no more common factors."
      ],
      "front": "How do you find the [[kw:greatest common divisor (GCD)]]?"
    },
    {
      "front": "What is the opposite of reducing a fraction?",
      "back": [
        "[[kw:Raising to higher terms]]!",
        "Multiply numerator and denominator by the same number.",
        "Example: $\\frac{3}{4} = \\frac{9}{12}$ (multiplied by 3)."
      ]
    },
    {
      "back": [
        "[[imp:Multiplier = (New Denominator) ÷ (Old Denominator).]]",
        "New Numerator = Old Numerator × Multiplier.",
        "Example: $\\frac{2}{3} = \\frac{?}{9} \\rightarrow 9÷3=3, 2×3=6$."
      ],
      "front": "How do you find a missing numerator when raising a fraction?"
    },
    {
      "front": "Is $\\frac{5}{5}$ proper or improper?",
      "back": [
        "[[imp:Improper – value equals exactly 1.]]",
        "Numerator = Denominator."
      ]
    },
    {
      "front": "Convert $\\frac{22}{7}$ to a mixed number.",
      "back": [
        "22 ÷ 7 = 3 remainder 1 → $3\\frac{1}{7}$."
      ]
    },
    {
      "front": "Reduce $\\frac{18}{24}$ to lowest terms.",
      "back": [
        "GCD is 6.",
        "$18 \\div 6 = 3$, $24 \\div 6 = 4$ → $\\frac{3}{4}$."
      ]
    }
  ],
