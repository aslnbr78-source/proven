rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isTeacher() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    function isPublishedCourse(courseId) {
      return firestore.get(/databases/(default)/documents/courses/$(courseId)).data.published == true;
    }

    match /courses/{courseId}/{fileName} {
      allow read: if isPublishedCourse(courseId) || isTeacher();
      allow write: if isTeacher();
    }
  }
}
